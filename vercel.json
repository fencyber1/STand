{
  "functions": {
    "api/generate.ts": { "maxDuration": 60 },
    "api/flux.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!assets/|manifest.json|sw.js|icon-.*\\.png|firebase-messaging-sw.js).*)", "destination": "/index.html" }
  ]
}
